# Copy this file to .env and fill in your values
# NEVER commit .env to git — it contains secrets

# ── Email Notification ────────────────────────────────────
# QQ Mail (recommended for China mainland)
SMTP_SERVER=smtp.qq.com
SMTP_PORT=465
SENDER_EMAIL=your_email@qq.com
SENDER_PASSWORD=your_qq_authorization_code
RECIPIENT_EMAIL=your_email@qq.com

# Gmail (recommended for overseas / GitHub Actions)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SENDER_EMAIL=your_email@gmail.com
# SENDER_PASSWORD=your_gmail_app_password
# RECIPIENT_EMAIL=your_email@gmail.com

# ── Discord Bot (optional) ────────────────────────────────
# Only needed if you want to scrape Discord servers
# Create bot at: https://discord.com/developers/applications
# DISCORD_BOT_TOKEN=your_bot_token_here
